# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Firebase Realtime Database (Admin SDK)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# MQTT — backend connects with full URL
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT — LAN host returned to ESP32 devices after provisioning (no mqtt:// prefix)
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883

# Backend URL used by simulators (include /api suffix)
BACKEND_URL=http://localhost:5000/api

# Email alerts (optional — Gmail App Password recommended)
EMAIL_USER=
EMAIL_PASS=
